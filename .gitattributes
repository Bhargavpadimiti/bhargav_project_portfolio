# Normalize line endings: LF in the repository, native on checkout where needed.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never diff or normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary

# Language stats on GitHub: don't count scaffolding templates or docs
templates/** linguist-documentation
docs/**      linguist-documentation
